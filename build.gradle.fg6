plugins {
    id 'eclipse'
    id 'idea'
    id 'net.minecraftforge.gradle' version '[6.0.24,6.2)'
}

group = mod_group
version = mod_version
base { archivesName = "${mod_id}-forge-${minecraft_version}" }

// NOTE: ForgeGradle 6 on Gradle 8.x must NOT rely on `java { toolchain { ... } }`.
// When the toolchain spec is only realised while ForgeGradle lazily resolves its
// Minecraft artifacts, Gradle 8 has already closed the project scope and throws
//     IllegalStateException: ProjectScopeServices has been closed
// inside MinecraftUserRepo.findBinpatched(). The failure then surfaces as
//     MinecraftUserRepo: Failed to get Minecraft Vanilla Base
//     java.lang.IllegalArgumentException: 不支持发行版本 17
// which reads like a broken build setup rather than a toolchain lifecycle bug.
// The 1.18.2/1.19.2/1.20.1 projects still carry the block and only survive
// because Gradle 8.4 happens to have a live-enough project scope; pinning the JDK
// through JAVA_HOME and `options.release` is the robust form.
java {
    // 1.17.1 runs on Java 16+; Java 17 bytecode is the safe target and matches
    // what the other projects in this repository emit.
    sourceCompatibility = JavaVersion.VERSION_17
    targetCompatibility = JavaVersion.VERSION_17
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'
    options.release = 17
}

sourceSets.main {
    // 加载器无关的核心逻辑，两个平台工程共用同一份源码。
    // 本仓库每个分支自带工程根下的 common/ 目录，因此用 file('common/...')。
    java.srcDir file('common/java')
    resources.srcDir file('common/resources')
}

minecraft {
    mappings channel: mapping_channel, version: mapping_version
    copyIdeResources = true

    runs {
        configureEach {
            workingDirectory project.file('run')
            property 'forge.logging.markers', 'REGISTRIES'
            property 'forge.logging.console.level', 'debug'
            // 开发环境从 build/classes + build/resources 加载，没有 jar manifest，
            // 所以用 JVM 参数直接告诉 Mixin 去加载哪个配置。
            jvmArgs '-Dmixin.configs=tickcontrol.mixins.json', '-DMixinConfigs=tickcontrol.mixins.json'
            mods {
                "${mod_id}" {
                    source sourceSets.main
                }
            }
        }
        client {
            property 'forge.enabledGameTestNamespaces', mod_id
            args '--width', '1920', '--height', '1080'
        }
        server {
            property 'forge.enabledGameTestNamespaces', mod_id
            args '--nogui'
            // 无人值守自检：gradle runServer -Pselftest
            if (project.hasProperty('selftest')) {
                jvmArgs '-Dtickcontrol.selftest=true', '-Dtickcontrol.selftest.stop=true'
            }
            // 主循环注入诊断：gradle runServer -Ptickdebug
            if (project.hasProperty('tickdebug')) {
                jvmArgs '-Dtickcontrol.debug=true'
            }
            // 便于排查注入问题：gradle runServer -PmixinDebug
            if (project.hasProperty('mixinDebug')) {
                property 'mixin.debug', 'true'
                property 'mixin.debug.verbose', 'true'
                property 'mixin.debug.export', 'true'
            }
        }
    }
}

repositories {
    maven {
        name = 'MinecraftForge'
        url = 'https://maven.minecraftforge.net/'
    }
}

dependencies {
    minecraft "net.minecraftforge:forge:${forge_version}"
}

tasks.named('processResources', ProcessResources).configure {
    def props = [
        mod_id                 : mod_id,
        mod_name               : mod_name,
        mod_version            : mod_version,
        mod_authors            : mod_authors,
        mod_license            : mod_license,
        mod_description        : mod_description,
        minecraft_version      : minecraft_version,
        minecraft_version_range: minecraft_version_range,
        forge_version          : forge_version,
        forge_version_range    : forge_version_range,
        loader_version_range   : loader_version_range,
    ]
    inputs.properties(props)
    filesMatching(['META-INF/mods.toml', 'pack.mcmeta']) {
        expand props
    }
}

tasks.named('jar', Jar).configure {
    manifest {
        attributes([
            'Specification-Title'     : mod_id,
            'Specification-Vendor'    : mod_authors,
            'Specification-Version'   : '1',
            'Implementation-Title'    : mod_name,
            'Implementation-Version'  : mod_version,
            'Implementation-Vendor'   : mod_authors,
            // Forge 1.20.1 通过 manifest 的 MixinConfigs 发现 Mixin 配置。
            // mods.toml 里的 [[mixins]] 段是 1.20.5+ 的写法，在 1.20.1 上会被
            // MixinPlatformAgentMinecraftForge 直接拒绝，配置不会生效。
            'MixinConfigs'            : 'tickcontrol.mixins.json',
        ])
    }
    finalizedBy 'reobfJar'
}
