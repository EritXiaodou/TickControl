# TickControl —— 1.12.2 的英文语言文件
#
# 为什么同时提供 .lang 和 .json:1.12.2 的语言加载器读取的是**旧的 .lang 格式**
# (vanilla 客户端 jar 里 assets/minecraft/lang/ 下只有一个 en_us.lang,没有任何 .json)。
# 只提供 .json 会导致客户端语言表里根本没有这些键,聊天栏于是显示原始键名。
# 已由运行期诊断证实:I18n.canTranslate(...) 返回 false。
# .json 保留是为了兼容同源码树里的其它版本习惯,真正生效的是本文件。
tickcontrol.commands.tick.status.frozen=Ticking is frozen
tickcontrol.commands.tick.status.running=Ticking is running
tickcontrol.commands.tick.status.lagging=Ticking is running, but can't keep up with the target tick rate
tickcontrol.commands.tick.status.sprinting=Ticking is sprinting
tickcontrol.commands.tick.query.rate.running=Target tick rate: %s per second. Average time per tick: %s ms (target: %s ms)
tickcontrol.commands.tick.query.rate.sprinting=Target tick rate: %s per second (ignored while sprinting). Average time per tick: %s ms
tickcontrol.commands.tick.query.percentiles=Percentiles of tick times (%s samples): P50: %s ms, P95: %s ms, P99: %s ms. Average: %s ms
tickcontrol.commands.tick.rate.success=Set the target tick rate to %s per second
tickcontrol.commands.tick.rate.capped=The requested tick rate %s is above this version's reachable maximum; using %s instead
tickcontrol.commands.tick.step.success=Stepping forward %s ticks
tickcontrol.commands.tick.step.fail=Unable to step forward because ticking is not frozen
tickcontrol.commands.tick.step.stop.success=Stopped stepping forward
tickcontrol.commands.tick.step.stop.fail=Unable to stop stepping forward because ticking is not stepping
tickcontrol.commands.tick.sprint.stop.success=Stopped sprinting
tickcontrol.commands.tick.sprint.stop.fail=Unable to stop sprinting because ticking is not sprinting
tickcontrol.commands.tick.freeze.fail.sprinting=Unable to freeze the game while it is sprinting
tickcontrol.commands.tick.sprint.report=Sprint completed: %s ticks per second, %s ms/tick
tickcontrol.commands.tick.usage=/tick <query|rate <rate>|freeze|unfreeze|step [<time>|stop]|sprint <time>|stop>
tickcontrol.commands.tick.unavailable=Tick Control is not active on this server
tickcontrol.commands.tick.time.invalid=Invalid time "%s": expected a positive number of ticks, optionally with a t/s/d suffix
tickcontrol.commands.tick.rate.invalid=Invalid tick rate "%s": expected a number between 1 and 10000
